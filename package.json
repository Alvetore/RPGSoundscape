{
  "name": "rpg-soundscape-studio",
  "version": "1.0.0",
  "description": "RPG Soundscape Studio — десктопное приложение для ведущих и игроков настольных ролевых игр",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron electron/main.cjs",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder --win",
    "pack": "npm run build:frontend && electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvetore/RPGSoundscape.git"
  },
  "keywords": [
    "rpg",
    "soundscape",
    "electron",
    "soundboard"
  ],
  "author": "Alvetore",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rpg.soundscape",
    "productName": "RPGSoundscape",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**",
          "!__pycache__/**",
          "!tests/**",
          "!requirements-dev.txt",
          "!*.pyc"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "files": [
      "electron/**/*",
      "icon.ico"
    ],
    "asar": true
  },
  "dependencies": {
    "youtubei.js": "^18.3.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
