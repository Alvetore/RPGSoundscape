{
  "name": "rpg-soundscape-studio",
  "version": "1.1.1",
  "description": "RPG Soundscape Studio — десктопное приложение для ведущих и игроков настольных ролевых игр",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron electron/main.cjs",
    "prepare:runtime": "py -3.14 scripts\\prepare_runtime.py",
    "build:backend": "py -3.14 scripts\\build_backend.py",
    "build:frontend": "cd frontend && npm run build",
    "build:android": "py -3.14 scripts\\build_android.py",
    "dist": "npm run prepare:runtime && npm run build:backend && npm run build:frontend && electron-builder --win",
    "pack": "npm run prepare:runtime && npm run build:backend && npm run build:frontend && electron-builder --dir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alvetore/RPGSoundscape.git"
  },
  "keywords": [
    "rpg",
    "soundscape",
    "electron",
    "soundboard"
  ],
  "author": "Alvetore",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rpg.soundscape",
    "productName": "RPGSoundscape",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "RPGSoundscape-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPG Soundscape Studio",
      "artifactName": "RPGSoundscape-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RPGSoundscape-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend-dist"
      },
      {
        "from": "backend/audio_library",
        "to": "backend/audio_library"
      },
      {
        "from": "backend/bin",
        "to": "backend/bin"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "files": [
      "electron/**/*",
      "icon.ico"
    ],
    "asar": true
  },
  "dependencies": {
    "youtubei.js": "^18.3.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
